---
import '../styles/global.css';
import site from '../../site.config.mjs';

interface Props {
  title?: string;
  description?: string;
  math?: boolean;
  canonical?: string;
  noindex?: boolean;
}
const { title, description = site.tagline, math = false, canonical, noindex = false } = Astro.props;
const fullTitle = title ? `${title}` : `${site.name} — ${site.tagline}`;
const KATEX = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(!site.indexable || noindex) && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/atom+xml" title={`${site.name} feed`} href="/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono&display=swap" />
    <slot name="head" />
    {math && (
      <>
        <link rel="stylesheet" href={`${KATEX}/katex.min.css`} />
        <script is:inline defer src={`${KATEX}/katex.min.js`}></script>
        <script is:inline defer src={`${KATEX}/contrib/auto-render.min.js`}
          onload="renderMathInElement(document.querySelector('main'),{delimiters:[{left:'$$',right:'$$',display:true},{left:'\\(',right:'\\)',display:false},{left:'$',right:'$',display:false}],throwOnError:false})"></script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#content">Skip to main content</a>
    <header class="site-header">
      <a class="logo" href="/" aria-label={`${site.name} home`}>dong<span>xiv</span></a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/search/" class="nav-search">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span>Search</span>
        </a>
        <a href="/list/">Recent</a>
        <a href="/about/">About</a>
        <a href="/feed.xml">Feed</a>
      </nav>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{site.name} is a personal archive of papers by {site.author}. Materials on this site are not peer-reviewed. Not affiliated with arXiv or Cornell University.</p>
      <p class="footer-links">
        <a href="/about/">About</a><span>•</span><a href="/list/">Recent</a><span>•</span><a href="/search/">Search</a><span>•</span><a href="/feed.xml">Atom feed</a><span>•</span><a href={site.repoUrl}>Source</a>
      </p>
    </footer>
  </body>
</html>
