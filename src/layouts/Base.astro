---
import '../styles/global.css';
import site from '../../site.config.mjs';

interface Crumb { label: string; href?: string }
interface Props {
  title?: string;
  description?: string;
  crumbs?: Crumb[];
  math?: boolean;
  canonical?: string;
  noindex?: boolean;
}
const { title, description = site.tagline, crumbs = [], math = false, canonical, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const KATEX = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(!site.indexable || noindex) && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/atom+xml" title={`${site.name} feed`} href="/feed.xml" />
    <slot name="head" />
    {math && (
      <>
        <link rel="stylesheet" href={`${KATEX}/katex.min.css`} />
        <script is:inline defer src={`${KATEX}/katex.min.js`}></script>
        <script is:inline defer src={`${KATEX}/contrib/auto-render.min.js`}
          onload="renderMathInElement(document.querySelector('main'),{delimiters:[{left:'$$',right:'$$',display:true},{left:'\\(',right:'\\)',display:false},{left:'$',right:'$',display:false}],throwOnError:false})"></script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="mast">
      <div class="mast-in">
        <a class="wordmark" href="/" aria-label={`${site.name} home`}>
          <span class="wm-name">dong<span class="wm-xiv">xiv</span></span>
          <span class="wm-tag">{site.tagline}</span>
        </a>
        <form class="mast-search" action="/search/" method="get" role="search">
          <input type="search" name="q" placeholder="Search title, author, abstract, ID…" aria-label="Search papers" />
          <button type="submit">Search</button>
        </form>
      </div>
    </header>
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-in">
        <a href="/">{site.name}</a>
        {crumbs.map((c) => (
          <>
            <span class="sep" aria-hidden="true">›</span>
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
        <span class="crumbs-links">
          <a href="/">Papers</a>
          <a href="/about/">About</a>
          <a href="/feed.xml">Feed</a>
        </span>
      </div>
    </nav>
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="foot-in">
        <span>{site.name} · a personal paper archive by {site.author}</span>
        <span class="foot-links">
          <a href="/about/">About</a>
          <a href="/feed.xml">Atom feed</a>
          <a href={site.repoUrl}>Source</a>
        </span>
        <span class="foot-note">Not affiliated with arXiv or Cornell University.</span>
      </div>
    </footer>
  </body>
</html>
