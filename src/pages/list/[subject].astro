---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import site from '../../../site.config.mjs';
import { getPapers, type Paper } from '../../lib/papers';
import { slug, subjectsOf } from '../../lib/format';

export function getStaticPaths() {
  const papers = getPapers();
  return subjectsOf(papers).map((s) => ({
    params: { subject: s.key },
    props: { name: s.name, papers: papers.filter((p) => [p.primary_subject, ...p.subjects].some((x) => slug(x) === s.key)) },
  }));
}
interface Props { name: string; papers: Paper[] }
const { name, papers } = Astro.props;
---
<Base title={`${name} — ${site.name}`} math>
  <Listing heading={name} papers={papers} />
</Base>
