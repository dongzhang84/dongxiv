---
// 摘要页：/abs/<id>/ 是最新版，/abs/<id>vN/ 是指定版本
import Base from '../../layouts/Base.astro';
import site from '../../../site.config.mjs';
import { getPapers, latest, type Paper, type PaperVersion } from '../../lib/papers';
import {
  pid, absUrl, pdfUrl, full, inline, esc, paragraphs, subjectUrl, checkingText, bibtex,
  fmtShort, fmtDateTime, fmtDay,
} from '../../lib/format';

export function getStaticPaths() {
  // 上一篇/下一篇只在列出的论文之间跳转；撤稿的论文保留摘要页（旧链接仍可访问），但不参与浏览
  const listed = [...getPapers()].reverse().filter((p) => !p.withdrawn); // 从旧到新
  return getPapers().flatMap((paper) => {
    const i = listed.indexOf(paper);
    const nav = i < 0 ? {} : { prev: listed[i - 1]?.id, next: listed[i + 1]?.id };
    return [
      { params: { id: paper.id }, props: { paper, version: latest(paper), pinned: false, nav } },
      ...paper.versions.map((version) => ({
        params: { id: `${paper.id}v${version.v}` },
        props: { paper, version, pinned: true, nav },
      })),
    ];
  });
}

interface Props {
  paper: Paper;
  version: PaperVersion;
  pinned: boolean;
  nav: { prev?: string; next?: string };
}
const { paper: p, version: v, pinned, nav } = Astro.props;
const last = latest(p);
const isLatest = v.v === last.v;
const multi = p.versions.length > 1;
const vb = p.vibe;
const license = p.license ?? site.defaultLicense;
const link = (l: { label: string; url: string }) => `<a href="${esc(l.url)}">${inline(l.label)}</a>`;

// 日期行
const v1 = `<a href="${absUrl(p.id, 1)}">v1</a>`;
let dateline = `Submitted on ${fmtShort(p.first)}`;
if (multi) {
  if (isLatest) dateline += ` (${v1}), last revised ${fmtShort(v.date)} (this version, v${v.v})`;
  else if (v.v === 1) dateline += ` (this version), latest version ${fmtShort(last.date)} (<a href="${absUrl(p.id, last.v)}">v${last.v}</a>)`;
  else dateline += ` (${v1}), revised ${fmtShort(v.date)} (this version, v${v.v}), latest version ${fmtShort(last.date)} (<a href="${absUrl(p.id, last.v)}">v${last.v}</a>)`;
}

// 元数据表里关于 AI 的几行
const tools = [...vb.agents, ...vb.models];
const checking = checkingText(vb);

const abs = full(absUrl(p.id));
const ymd = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '/');
const description = p.abstract.trim().replace(/\s+/g, ' ').slice(0, 300);
const shownId = `${p.id}${pinned ? `v${v.v}` : ''}`;
---
<Base title={`[${shownId}] ${p.title}`} description={description} canonical={abs} noindex={pinned || !!p.withdrawn} math>
  {!p.withdrawn && <Fragment slot="head">
    <meta name="citation_title" content={p.title} />
    {p.authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={ymd(p.first)} />
    <meta name="citation_online_date" content={ymd(v.date)} />
    <meta name="citation_pdf_url" content={full(pdfUrl(p.id, pinned ? v.v : undefined))} />
    <meta name="citation_abstract_html_url" content={abs} />
    <meta name="citation_publisher" content={site.name} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={p.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs} />
  </Fragment>}

  <div id="abs-outer">
    <div class="leftcolumn">
      <div class="subheader">
        <h1><a href="/">{site.name}</a> &gt; {p.withdrawn ? p.primary_subject : <a href={subjectUrl(p.primary_subject)}>{p.primary_subject}</a>}</h1>
      </div>
      <div id="abs">
        <div class="dateline">[<Fragment set:html={dateline} />]</div>
        {p.withdrawn && <p class="withdrawn-note"><strong>Withdrawn:</strong> <span set:html={inline(p.withdrawn)} /></p>}
        <h1 class="title"><span class="descriptor">Title:</span>{p.title}</h1>
        <div class="authors">
          <span class="descriptor">Authors:</span>{p.authors.join(', ')}
        </div>
        <a class="mobile-download" href={pdfUrl(p.id, pinned ? v.v : undefined)}>View PDF</a>
        <blockquote class="abstract">
          <span class="descriptor">Abstract:</span>
          {paragraphs(p.abstract).map((para) => <p>{para}</p>)}
        </blockquote>

        <div class="metatable">
          <table>
            {p.comments && <tr><td class="label">Comments:</td><td class="comments" set:html={inline(p.comments)} /></tr>}
            <tr>
              <td class="label">Subjects:</td>
              <td><span class="primary-subject">{p.primary_subject}</span>{p.subjects.length > 0 && `; ${p.subjects.join('; ')}`}</td>
            </tr>
            {p.keywords.length > 0 && <tr><td class="label">Keywords:</td><td>{p.keywords.join(', ')}</td></tr>}
            {tools.length > 0 && <tr><td class="label">AI tools:</td><td>{tools.join('; ')}</td></tr>}
            {vb.human_role && <tr><td class="label">Author's role:</td><td set:html={inline(vb.human_role)} /></tr>}
            {checking && <tr><td class="label"><a href="/about/#ai">Checking</a>:</td><td>{checking}</td></tr>}
            {vb.materials.length > 0 && <tr><td class="label">Materials:</td><td set:html={vb.materials.map(link).join(', ')} /></tr>}
            {vb.notes && <tr><td class="label">AI notes:</td><td set:html={inline(vb.notes)} /></tr>}
            {p.links.length > 0 && <tr><td class="label">Links:</td><td set:html={p.links.map(link).join(', ')} /></tr>}
            <tr>
              <td class="label">Cite as:</td>
              <td><span class="arxivid"><a href={absUrl(p.id)}>{pid(p.id)}</a></span></td>
            </tr>
            <tr>
              <td class="label">&nbsp;</td>
              <td>(or <span class="arxivid"><a href={absUrl(p.id, v.v)}>{pid(p.id, v.v)}</a></span> for this version)</td>
            </tr>
            <tr>
              <td class="label">&nbsp;</td>
              <td><a href={abs}>{abs}</a></td>
            </tr>
          </table>
        </div>
      </div>

      <div class="submission-history">
        <h2>Submission history</h2>
        From: {p.authors[0]}<br />
        {p.versions.map((x) => (
          <>
            <strong>{x.v === v.v && pinned ? `[v${x.v}]` : <a href={absUrl(p.id, x.v)}>[v{x.v}]</a>}</strong>
            {' '}{x.dateOnly ? fmtDay(x.date) : fmtDateTime(x.date)}{x.pages && ` (${x.pages} pages)`}
            {x.note && <span class="version-note"> — <Fragment set:html={inline(x.note)} /></span>}
            <br />
          </>
        ))}
        <details class="checksums">
          <summary>SHA-256 checksums of the PDFs</summary>
          <table>
            {p.versions.map((x) => <tr><td>v{x.v}</td><td><code>{x.sha256}</code></td></tr>)}
          </table>
          <p>Every posted PDF is kept unchanged. <a href="/about/#integrity">How to check a download</a>.</p>
        </details>
      </div>
    </div>

    <div class="extra-services">
      <div class="full-text">
        <h2>Access Paper:</h2>
        <ul>
          <li><a class="abs-button" href={pdfUrl(p.id, pinned ? v.v : undefined)}>View PDF</a></li>
          {!isLatest && <li><a class="abs-button" href={pdfUrl(p.id)}>Latest version (v{last.v})</a></li>}
          {p.links.map((l) => <li><a class="abs-button" href={l.url}>{l.label}</a></li>)}
        </ul>
        <div class="abs-license">License: {license}</div>
      </div>

      {!p.withdrawn && <div class="browse">
        <h3>Current browse context:</h3>
        <div class="current"><a href={subjectUrl(p.primary_subject)}>{p.primary_subject}</a></div>
        <div class="prevnext">
          {nav.prev ? <a href={absUrl(nav.prev)} rel="prev">&lt;&nbsp;prev</a> : <span>&lt;&nbsp;prev</span>}
          &nbsp;|&nbsp;
          {nav.next ? <a href={absUrl(nav.next)} rel="next">next&nbsp;&gt;</a> : <span>next&nbsp;&gt;</span>}
        </div>
        <div class="list"><a href={subjectUrl(p.primary_subject)}>recent</a> | <a href="/">all papers</a></div>
        {p.subjects.length > 0 && (
          <>
            <div class="abs-switch-cat">Change to browse by:</div>
            <div class="switch">{p.subjects.map((s) => <><a href={subjectUrl(s)}>{s}</a><br /></>)}</div>
          </>
        )}
      </div>}

      <div class="bib-export">
        <h3><a href="#bibtex" id="bib-toggle" aria-controls="bibtex" aria-expanded="false">Export BibTeX Citation</a></h3>
        <div id="bibtex" hidden>
          <pre id="bib">{bibtex(p, pinned ? v : undefined)}</pre>
          <button type="button" class="copy" data-target="bib">Copy to clipboard</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const toggle = document.getElementById('bib-toggle');
    const box = document.getElementById('bibtex');
    toggle?.addEventListener('click', (e) => {
      e.preventDefault();
      if (!box) return;
      box.hidden = !box.hidden;
      toggle.setAttribute('aria-expanded', String(!box.hidden));
    });
    document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((b) => {
      b.addEventListener('click', async () => {
        const el = document.getElementById(b.dataset.target!);
        if (!el) return;
        try {
          await navigator.clipboard.writeText(el.textContent ?? '');
          b.textContent = 'Copied';
        } catch {
          b.textContent = 'Select and copy manually';
        }
        setTimeout(() => (b.textContent = 'Copy to clipboard'), 1500);
      });
    });
  </script>
</Base>
