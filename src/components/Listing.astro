---
// 按首次发布日分组的论文列表（新的在上）
import Entry from './Entry.astro';
import type { Paper } from '../lib/papers';
import { fmtDay, dayKey } from '../lib/format';

interface Props { heading?: string; papers: Paper[] }
const { heading, papers } = Astro.props;

const days: { key: string; date: Date; items: { paper: Paper; n: number }[] }[] = [];
papers.forEach((paper, i) => {
  const key = dayKey(paper.first);
  let g = days[days.length - 1];
  if (!g || g.key !== key) days.push((g = { key, date: paper.first, items: [] }));
  g.items.push({ paper, n: i + 1 });
});
const entries = (k: number) => `${k} ${k === 1 ? 'entry' : 'entries'}`;
---
<div class="listing">
  {heading && <h1>{heading}</h1>}
  {papers.length === 0 ? (
    <p>No papers yet.</p>
  ) : (
    <>
      <p class="totals">Total of {entries(papers.length)}</p>
      {days.map((d) => (
        <>
          <h3 id={`d${d.key}`}>{fmtDay(d.date)}{d.items.length > 1 && <span class="count"> ({entries(d.items.length)})</span>}</h3>
          <dl class="list">
            {d.items.map((it) => <Entry paper={it.paper} n={it.n} />)}
          </dl>
        </>
      ))}
    </>
  )}
</div>
